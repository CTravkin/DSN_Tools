SYNCTHING_USER=syncthing
ACL_USERS=alice,bob
# Optional comma-separated exact directories: read/search access without write.
# Children keep their usual policy and default ACL inheritance.
# ACL_READONLY_DIRECTORIES=/srv/syncthing/documents
# Optional read-only subtrees: included files receive read access, directories
# receive read/search access, and managed default ACLs inherit read-only access.
# ACL_READONLY_TREES=/srv/syncthing/archive

# Leave unset to discover config.xml under the Syncthing service user's home.
# SYNCTHING_CONFIG=/var/lib/syncthing/.local/state/syncthing/config.xml

STATE_PATH=/var/lib/syncthing-acl-refresh/state.sqlite3
TLS_CERTIFICATE=/etc/syncthing-acl-refresh/https-cert.pem
FOLDER_ALLOWLIST=/etc/syncthing-acl-refresh/folders.conf
