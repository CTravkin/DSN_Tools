SYNCTHING_USER=syncthing
ACL_USERS=alice,bob

# Leave unset to discover config.xml under the Syncthing service user's home.
# SYNCTHING_CONFIG=/var/lib/syncthing/.local/state/syncthing/config.xml

STATE_PATH=/var/lib/syncthing-acl-refresh/state.sqlite3
TLS_CERTIFICATE=/etc/syncthing-acl-refresh/https-cert.pem
FOLDER_ALLOWLIST=/etc/syncthing-acl-refresh/folders.conf
