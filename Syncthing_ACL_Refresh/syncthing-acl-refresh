def parse_folder_allowlist(text: str) -> dict[str, Path]:
    result: dict[str, Path] = {}
    for line_number, raw_line in enumerate(text.splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        folder_id, separator, raw_path = line.partition("=")
        folder_id, raw_path = folder_id.strip(), raw_path.strip()
        if not separator or not re.fullmatch(r"[A-Za-z0-9._-]+", folder_id) or not raw_path:
            raise ValueError(f"Invalid folder allowlist entry at line {line_number}")
        path = Path(os.path.abspath(raw_path))
        if not Path(raw_path).is_absolute():
            raise ValueError(f"Allowlisted folder path must be absolute: {raw_path}")
        if path == Path("/") or any(path == system or path.is_relative_to(system) for system in SYSTEM_PATHS):
            raise ValueError(f"Refusing system path in folder allowlist: {path}")
        if folder_id in result:
            raise ValueError(f"Duplicate folder ID in allowlist: {folder_id}")
        result[folder_id] = path
    if not result:
        raise ValueError("Folder allowlist must contain at least one folder")
    return result


def load_folder_allowlist(path: Path) -> dict[str, Path]:
    path = Path(os.path.abspath(path))
    parent_fd = os.open("/", os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for component in path.parent.parts[1:]:
            next_fd = os.open(
                component,
                os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=parent_fd,
            )
            os.close(parent_fd)
            parent_fd = next_fd
            metadata = os.fstat(parent_fd)
            if metadata.st_uid != 0 or metadata.st_mode & 0o022:
                raise ValueError(
                    f"Folder allowlist parent must be root-owned and not writable by group or others: {path.parent}"
                )
        file_fd = os.open(
            path.name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent_fd,
        )
        try:
            metadata = os.fstat(file_fd)
            if not stat.S_ISREG(metadata.st_mode):
                raise ValueError(f"Folder allowlist must be a regular file: {path}")
            if metadata.st_uid != 0 or metadata.st_mode & 0o022:
                raise ValueError(
                    "Folder allowlist must be owned by root and not writable by group or others"
                )
            with os.fdopen(file_fd, "r", encoding="utf-8") as source:
                file_fd = -1
                return parse_folder_allowlist(source.read())
        finally:
            if file_fd >= 0:
                os.close(file_fd)
    finally:
        os.close(parent_fd)


def require_allowed_folders(
    folders: list[FolderConfiguration], allowlist: Mapping[str, Path]
) -> list[FolderConfiguration]:
    configured = {folder.folder_id: folder for folder in folders}
    for folder_id, folder in configured.items():
        expected = allowlist.get(folder_id)
        if expected is None or folder.path != expected:
            raise ValueError(
                f"Syncthing folder is not allowlisted with its exact path: {folder_id}={folder.path}"
            )
    missing = sorted(set(allowlist) - set(configured))
    if missing:
        raise ValueError("Allowlisted Syncthing folders are missing from configuration: " + ", ".join(missing))
    return sorted(configured.values(), key=lambda item: (len(item.path.parts), os.fspath(item.path)))


def normalize_gui_https(address: str, use_tls: bool) -> str:
    if not use_tls:
        raise ValueError("Syncthing GUI must enforce HTTPS for the root helper")
    value = address.strip()
    parsed = urllib.parse.urlsplit(value if "://" in value else f"//{value}")
    if parsed.scheme and parsed.scheme != "https":
        raise ValueError("Syncthing GUI must use HTTPS")
    host = parsed.hostname
    try:
        address = ipaddress.ip_address(host or "")
    except ValueError as error:
        raise ValueError("Syncthing GUI host must be a loopback IP literal") from error
    if not address.is_loopback:
        raise ValueError("Syncthing GUI must listen on loopback")
    port = parsed.port or 8384
    return f"https://{'[' + host + ']' if ':' in host else host}:{port}"


def read_configuration(config_path: Path, home: Path) -> tuple[GuiConfiguration, list[FolderConfiguration]]:
    root = ET.parse(config_path).getroot()
    gui_element: ET.Element | None = None
    folders: dict[str, FolderConfiguration] = {}
    for element in root.iter():
        name = local_name(element)
        if name == "gui" and gui_element is None:
            gui_element = element
        elif name == "folder":
            folder_id = element.attrib.get("id", "").strip()
            raw_path = element.attrib.get("path", "").strip()
            if folder_id and raw_path:
                if folder_id in folders:
                    raise ValueError(f"Duplicate Syncthing folder ID: {folder_id}")
                folders[folder_id] = FolderConfiguration(folder_id, resolve_folder_path(raw_path, home))
    if gui_element is None:
        raise ValueError("Syncthing GUI configuration is missing")
    children = {local_name(child): (child.text or "").strip() for child in gui_element}
    api_key = children.get("apikey", "")
    if not api_key:
        raise ValueError("Syncthing API key is missing")
    gui = GuiConfiguration(
        normalize_gui_https(
            children.get("address", "127.0.0.1:8384"),
            gui_element.attrib.get("tls", "false").lower() == "true",
        ),
        api_key,
        PINNED_CERTIFICATE_PATH,
    )
    return gui, sorted(folders.values(), key=lambda item: (len(item.path.parts), os.fspath(item.path)))


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, host: str, port: int, certificate_path: Path, timeout: float) -> None:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        super().__init__(host, port, timeout=timeout, context=context)
        self.certificate_path = certificate_path

    def connect(self) -> None:
        super().connect()
        assert isinstance(self.sock, ssl.SSLSocket)
        peer = self.sock.getpeercert(binary_form=True)
        pinned = ssl.PEM_cert_to_DER_cert(self.certificate_path.read_text(encoding="ascii"))
        if not hmac.compare_digest(hashlib.sha256(peer).digest(), hashlib.sha256(pinned).digest()):
            self.close()
            raise ssl.SSLError("Syncthing HTTPS certificate does not match the pinned certificate")


def api_json(gui: GuiConfiguration, endpoint: str, parameters: dict[str, str]) -> object:
    parsed = urllib.parse.urlsplit(gui.url)
    if parsed.scheme != "https" or parsed.hostname is None:
        raise ValueError("Only pinned HTTPS Syncthing API connections are supported")
    connection = PinnedHTTPSConnection(
        parsed.hostname, parsed.port or 443, gui.certificate_path, timeout=15
    )
    target = endpoint + (("?" + urllib.parse.urlencode(parameters)) if parameters else "")
    try:
        connection.request("GET", target, headers={"X-API-Key": gui.api_key, "Accept": "application/json"})
        response = connection.getresponse()
        if response.status != 200:
            raise OSError(f"Syncthing API returned HTTP {response.status}")
        return json.load(response)
    finally:
        connection.close()


def strip_pattern_prefixes(pattern: str) -> tuple[str, bool, bool]:
    case_insensitive = False
    negated = False
    while True:
        if pattern.startswith("(?i)"):
            case_insensitive, pattern = True, pattern[4:]
        elif pattern.startswith("(?d)"):
            pattern = pattern[4:]
        elif pattern.startswith("!"):
            negated, pattern = not negated, pattern[1:]
        else:
            return pattern, case_insensitive, negated


def split_brace_alternatives(value: str) -> list[str] | None:
    depth = 0
    escaped = False
    start = -1
    for index, character in enumerate(value):
        if escaped:
            escaped = False
            continue
        if character == "\\":
            escaped = True
        elif character == "{" and depth == 0:
            start, depth = index, 1
        elif character == "{" and depth:
            depth += 1
        elif character == "}" and depth:
            depth -= 1
            if depth == 0:
                inside = value[start + 1:index]
                alternatives: list[str] = []
                part_start = inner_depth = 0
                inner_escaped = False
                for inner_index, inner_character in enumerate(inside):
                    if inner_escaped:
                        inner_escaped = False
                    elif inner_character == "\\":
                        inner_escaped = True
                    elif inner_character == "{":
                        inner_depth += 1
                    elif inner_character == "}":
                        inner_depth -= 1
                    elif inner_character == "," and inner_depth == 0:
                        alternatives.append(inside[part_start:inner_index])
                        part_start = inner_index + 1
                alternatives.append(inside[part_start:])
                if len(alternatives) == 1:
                    return None
                return [value[:start] + item + value[index + 1:] for item in alternatives]
    return None


def expand_braces(pattern: str) -> list[str]:
    alternatives = split_brace_alternatives(pattern)
    if alternatives is None:
        return [pattern]
    result: list[str] = []
    for alternative in alternatives:
        result.extend(expand_braces(alternative))
    return result


def glob_to_regex(pattern: str) -> str:
    result: list[str] = []
    index = 0
    while index < len(pattern):
        character = pattern[index]
        if character == "\\":
            index += 1
            result.append(re.escape(pattern[index]) if index < len(pattern) else re.escape("\\"))
        elif character == "*":
            if index + 1 < len(pattern) and pattern[index + 1] == "*":
                index += 1
                if index + 1 < len(pattern) and pattern[index + 1] == "/":
                    index += 1
                    result.append("(?:.*/)?")
                else:
                    result.append(".*")
            else:
                result.append("[^/]*")
        elif character == "?":
            result.append("[^/]")
        elif character == "[":
            end = index + 1
            if end < len(pattern) and pattern[end] in "!^":
                end += 1
            if end < len(pattern) and pattern[end] == "]":
                end += 1
            while end < len(pattern) and pattern[end] != "]":
                end += 1
            if end >= len(pattern):
                result.append("\\[")
            else:
                content = pattern[index + 1:end]
                if content.startswith("!"):
                    content = "^" + content[1:]
                result.append("[" + content.replace("\\", "\\\\") + "]")
                index = end
        else:
            result.append(re.escape(character))
        index += 1
    return "".join(result)


@dataclass(frozen=True)
class CompiledIgnorePattern:
    regex: re.Pattern[str]
    negated: bool


@dataclass(frozen=True)
class TraversalRule:
    pattern_index: int
    prefix: str | None
    subtree: bool
    case_insensitive: bool


def literal_prefix(pattern: str) -> tuple[str, bool]:
    components: list[str] = []
    subtree = False
    for component in pattern.lstrip("/").split("/"):
        if not component:
            continue
        if any(character in component for character in "*?[]{}\\"):
            subtree = component == "**" and bool(components)
            break
        components.append(component)
    return "/".join(components), subtree


@dataclass(frozen=True)
class ControlPaths:
    files: set[str]
    parents: set[str]


def discover_control_paths(root: Path) -> ControlPaths:
    root = root.resolve()
    files = {".stignore", ".stfolder"}
    parents: set[str] = set()
    first = root / ".stignore"
    if not first.is_file():
        return ControlPaths(files, parents)
    visited: set[Path] = set()

    def visit(path: Path) -> None:
        logical = Path(os.path.abspath(path))
        try:
            logical_relative = logical.relative_to(root)
        except ValueError as error:
            raise ValueError(f"Syncthing ignore include escapes the folder root: {path}") from error
        resolved = logical.resolve(strict=True)
        try:
            relative = resolved.relative_to(root)
        except ValueError as error:
            raise ValueError(f"Syncthing ignore include escapes the folder root: {path}") from error
        for control_relative in {logical_relative, relative}:
            files.add(control_relative.as_posix())
            for parent in control_relative.parents:
                if parent != Path("."):
                    parents.add(parent.as_posix())
        if resolved in visited:
            return
        visited.add(resolved)
        for raw_line in resolved.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if line.startswith("#include "):
                include_name = line[len("#include "):].strip()
                if include_name:
                    visit(logical.parent / include_name)

    visit(first)
    return ControlPaths(files, parents)


class IgnoreMatcher:
    def __init__(
        self,
        expanded_patterns: Iterable[str],
        control_files: Iterable[str] = (".stignore", ".stfolder"),
        control_parents: Iterable[str] = (),
    ) -> None:
        self.patterns: list[CompiledIgnorePattern] = []
        self.control_files = set(control_files)
        self.control_parents = set(control_parents)
        self.traversal_rules: list[TraversalRule] = []
        for raw in expanded_patterns:
            pattern, case_insensitive, negated = strip_pattern_prefixes(raw.strip())
            if not pattern or pattern.startswith("//"):
                continue
            flags = re.IGNORECASE if case_insensitive else 0
            for expanded in expand_braces(pattern.lstrip("/")):
                pattern_index = len(self.patterns)
                self.patterns.append(
                    CompiledIgnorePattern(re.compile(rf"\A{glob_to_regex(expanded)}\Z", flags), negated)
                )
                if not negated:
                    continue
                prefix, subtree = literal_prefix(expanded)
                # Syncthing can skip an ignored directory only when every
                # preceding negation is rooted at the top level. A terminal
                # "/**" (or "**" within that top-level component) is safe;
                # nested paths and earlier double-stars require traversal
                # everywhere. The REST API's expanded patterns may no longer
                # retain the original leading slash, so infer this from the
                # expanded path shape.
                skip_check = expanded.removesuffix("/**")
                double_star_check = skip_check.removesuffix("**")
                requires_global_traversal = (
                    "/" in skip_check or "**" in double_star_check
                )
                if requires_global_traversal:
                    prefix = None
                elif not prefix:
                    continue
                self.traversal_rules.append(
                    TraversalRule(pattern_index, prefix, subtree, case_insensitive)
                )

    def first_match(self, relative_path: str) -> tuple[int, CompiledIgnorePattern] | None:
        for index, pattern in enumerate(self.patterns):
            if pattern.regex.fullmatch(relative_path):
                return index, pattern
        return None

    def is_included(self, relative_path: str) -> bool:
        normalized = relative_path.replace(os.sep, "/").strip("/")
        if not normalized:
            return True
        match = self.first_match(normalized)
        return True if match is None else match[1].negated

    def is_control_path(self, relative_path: str) -> bool:
        return relative_path.replace(os.sep, "/").strip("/") in self.control_files

    def directory_access(self, relative_path: str) -> AccessLevel:
        normalized = relative_path.replace(os.sep, "/").strip("/")
        if not normalized:
            return AccessLevel.FULL
        if self.is_control_path(normalized):
            return AccessLevel.NONE
        match = self.first_match(normalized)
        policy_access = AccessLevel.FULL if match is None or match[1].negated else AccessLevel.NONE
        if match is not None and not match[1].negated:
            ignore_index = match[0]
            for rule in self.traversal_rules:
                if rule.pattern_index >= ignore_index:
                    continue
                if rule.prefix is None:
                    policy_access = AccessLevel.TRAVERSE
                    break
                candidate = normalized.casefold() if rule.case_insensitive else normalized
                prefix = rule.prefix.casefold() if rule.case_insensitive else rule.prefix
                if prefix == candidate or prefix.startswith(candidate + "/"):
                    policy_access = AccessLevel.TRAVERSE
                    break
                if rule.subtree and candidate.startswith(prefix + "/"):
                    policy_access = AccessLevel.TRAVERSE
                    break
        if normalized in self.control_parents:
            return max(policy_access, AccessLevel.TRAVERSE, key=lambda item: item.value)
        return policy_access


def read_ignore_matcher(gui: GuiConfiguration, folder_id: str, root: Path) -> IgnoreMatcher:
    payload = api_json(gui, "/rest/db/ignores", {"folder": folder_id})
    if not isinstance(payload, dict):
        raise ValueError(f"Unexpected ignore response for folder {folder_id}")
    raw, expanded = payload.get("ignore") or [], payload.get("expanded") or []
    if not isinstance(raw, list) or not isinstance(expanded, list):
        raise ValueError(f"Invalid ignore response for folder {folder_id}")
    controls = discover_control_paths(root)
    return IgnoreMatcher([str(item) for item in expanded], controls.files, controls.parents)


@dataclass(frozen=True)
class FolderPolicy:
    folder_id: str
    root: Path
    matcher: IgnoreMatcher


def load_policies(config_path: Path, home: Path) -> list[FolderPolicy]:
    gui, folders = read_configuration(config_path, home)
    folders = require_allowed_folders(folders, load_folder_allowlist(ALLOWLIST_PATH))
    return [
        FolderPolicy(folder.folder_id, folder.path, read_ignore_matcher(gui, folder.folder_id, folder.path))
        for folder in folders
    ]


class ManagedTarget:
    def __init__(self, fd: int, display_path: Path, mode: int) -> None:
        self.fd, self.display_path, self.mode = fd, display_path, mode
        self.created_default_acl = False
        self.default_acl_cleared = False

    @property
    def proc_path(self) -> str:
        return f"/proc/self/fd/{self.fd}"

    def close(self) -> None:
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def __enter__(self) -> "ManagedTarget":
        return self

    def __exit__(self, _type: object, _value: object, _traceback: object) -> None:
        self.close()


def fd_mount_id(fd: int) -> int:
    with open(f"/proc/self/fdinfo/{fd}", encoding="ascii") as information:
        for line in information:
            if line.startswith("mnt_id:"):
                return int(line.partition(":")[2].strip())
    raise UnsafePathError("Kernel did not expose a mount ID for an opened path")


class ManagedRoot:
    def __init__(self, path: Path) -> None:
        self.path = Path(os.path.abspath(path))
        self.fd = -1
        self.resolved = Path()
        self.device = self.inode = 0
        self.mount_id = 0

    def __enter__(self) -> "ManagedRoot":
        current_fd = os.open("/", os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            for component in self.path.parts[1:]:
                next_fd = os.open(
                    component,
                    os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=current_fd,
                )
                os.close(current_fd)
                current_fd = next_fd
            self.fd = current_fd
            current_fd = -1
            metadata = os.fstat(self.fd)
            self.device, self.inode = metadata.st_dev, metadata.st_ino
            self.mount_id = fd_mount_id(self.fd)
            rendered = os.readlink(f"/proc/self/fd/{self.fd}")
            if rendered.endswith(" (deleted)"):
                raise UnsafePathError(f"Managed root disappeared while opening: {self.path}")
            self.resolved = Path(rendered)
            if self.resolved != self.path:
                raise UnsafePathError(f"Managed root contains a symbolic link: {self.path}")
            return self
        except BaseException:
            if current_fd >= 0:
                os.close(current_fd)
            self.close()
            raise

    def close(self) -> None:
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def __exit__(self, _type: object, _value: object, _traceback: object) -> None:
        self.close()

    def open_target(self, path: Path) -> ManagedTarget:
        path = Path(os.path.abspath(path))
        try:
            relative = path.relative_to(self.path)
        except ValueError as error:
            raise UnsafePathError(f"Path is outside managed root: {path}") from error
        fd = os.dup(self.fd)
        try:
            for index, component in enumerate(relative.parts):
                flags = os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC
                if index < len(relative.parts) - 1:
                    flags |= os.O_DIRECTORY
                next_fd = os.open(component, flags, dir_fd=fd)
                os.close(fd)
                fd = next_fd
            metadata = os.fstat(fd)
            if fd_mount_id(fd) != self.mount_id or metadata.st_dev != self.device:
                raise UnsafePathError(f"Path crosses a mount boundary below managed root: {path}")
            rendered = os.readlink(f"/proc/self/fd/{fd}")
            if rendered.endswith(" (deleted)"):
                raise FileNotFoundError(path)
            try:
                Path(rendered).relative_to(self.resolved)
            except ValueError as error:
                raise UnsafePathError(f"Path escaped managed root through a symbolic link: {path}") from error
            return ManagedTarget(fd, path, metadata.st_mode)
        except BaseException:
            os.close(fd)
            raise


def permission_bits(value: str) -> int:
    return sum(bit for character, bit in PERMISSION_BITS.items() if character in value)


def permission_text(value: int) -> str:
    return "".join(character if value & bit else "-" for character, bit in PERMISSION_BITS.items())


def acl_entries(target: ManagedTarget) -> dict[str, int]:
    result = subprocess.run(
        ("getfacl", "-cp", "--", target.proc_path),
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        pass_fds=(target.fd,),
    )
    entries: dict[str, int] = {}
    for raw_line in result.stdout.splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if line:
            key, separator, permissions = line.rpartition(":")
            if separator:
                entries[key + ":"] = permission_bits(permissions)
    return entries


def run_setfacl(target: ManagedTarget, arguments: list[str]) -> None:
    subprocess.run(
        ("setfacl", *arguments, "--", target.proc_path),
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        pass_fds=(target.fd,),
    )


def unmanaged_mask_conflicts(
    entries: dict[str, int], prefix: str, old_mask: int, new_mask: int
) -> list[str]:
    added = new_mask & ~old_mask
    managed = {f"{prefix}user:{user}:" for user in ACL_USERS}
    conflicts: list[str] = []
    for key, raw_permissions in entries.items():
        affected = (
            key == f"{prefix}group::"
            or key.startswith(f"{prefix}group:")
            or key.startswith(f"{prefix}user:")
        )
        if affected and key not in managed and key != f"{prefix}user::" and raw_permissions & added:
            conflicts.append(key)
    return conflicts


def has_unmanaged_execute(entries: dict[str, int], mask: int) -> bool:
    if entries.get("user::", 0) & 1 or entries.get("other::", 0) & 1:
        return True
    if entries.get("group::", 0) & mask & 1:
        return True
    managed = {f"user:{user}:" for user in ACL_USERS}
    return any(
        not key.startswith("default:")
        and key not in managed
        and key not in {"user::", "group::", "other::", "mask::"}
        and (key.startswith("user:") or key.startswith("group:"))
        and raw_permissions & mask & 1
        for key, raw_permissions in entries.items()
    )


def _set_managed_target_access(
    target: ManagedTarget,
    access: AccessLevel,
    previous_users: Iterable[str] = (),
    created_default_acl: bool = False,
) -> AclOutcome:
    try:
        entries = acl_entries(target)
        directory, regular = stat.S_ISDIR(target.mode), stat.S_ISREG(target.mode)
        if not (directory or regular):
            access = AccessLevel.NONE
        if access is AccessLevel.TRAVERSE and not directory:
            access = AccessLevel.NONE

        current_users = set(ACL_USERS)
        removable_users = current_users | set(previous_users)
        removals: list[str] = []
        for user in removable_users:
            if (access is AccessLevel.NONE or user not in current_users) and f"user:{user}:" in entries:
                removals.append(f"u:{user}")
            if directory and (access is not AccessLevel.FULL or user not in current_users) and f"default:user:{user}:" in entries:
                removals.append(f"d:u:{user}")
        changed = bool(removals)
        if removals:
            run_setfacl(target, ["-n", "-x", ",".join(removals)])
            entries = acl_entries(target)

        if access is AccessLevel.NONE:
            if directory and created_default_acl:
                remaining_default_named = any(
                    key.startswith("default:user:") and key != "default:user::"
                    or key.startswith("default:group:") and key != "default:group::"
                    for key in entries
                )
                if not remaining_default_named and "default:user::" in entries:
                    run_setfacl(target, ["-k"])
                    target.default_acl_cleared = True
                    changed = True
            if changed:
                log(f"Managed ACL removed: {target.display_path}")
                return AclOutcome.CHANGED
            return AclOutcome.UNCHANGED

        old_mask = entries.get("mask::", entries.get("group::", 0))
        desired_access = (
            1 if access is AccessLevel.TRAVERSE
            else 7 if directory or has_unmanaged_execute(entries, old_mask)
            else 6
        )
        new_mask = old_mask | desired_access
        conflicts = unmanaged_mask_conflicts(entries, "", old_mask, new_mask)
        default_exists = "default:user::" in entries
        old_default_mask = entries.get("default:mask::", entries.get("default:group::", 0))
        new_default_mask = old_default_mask | 7
        if directory and access is AccessLevel.FULL and default_exists:
            conflicts += unmanaged_mask_conflicts(entries, "default:", old_default_mask, new_default_mask)
        if conflicts:
            log(
                f"ACL mask conflict for {target.display_path}; unmanaged entries would gain rights: "
                + ",".join(conflicts)
            )
            return AclOutcome.FAILED
        access_ok = all(
            entries.get(f"user:{user}:", 0) == desired_access
            and (entries[f"user:{user}:"] & old_mask) == desired_access
            for user in ACL_USERS
        )
        default_ok = access is not AccessLevel.FULL or not directory or default_exists and all(
            entries.get(f"default:user:{user}:", 0) == 7
            and (entries[f"default:user:{user}:"] & old_default_mask) == 7
            for user in ACL_USERS
        )
        if access_ok and default_ok:
            return AclOutcome.CHANGED if changed else AclOutcome.UNCHANGED
        specifications = [f"u:{user}:{permission_text(desired_access)}" for user in ACL_USERS]
        specifications.append(f"m::{permission_text(new_mask)}")
        if directory and access is AccessLevel.FULL:
            if not default_exists:
                specifications.extend(("d:u::rwx", "d:g::---", "d:o::---"))
                target.created_default_acl = True
            specifications.extend(f"d:u:{user}:rwx" for user in ACL_USERS)
            specifications.append(f"d:m::{permission_text(new_default_mask)}")
        run_setfacl(target, ["-n", "-m", ",".join(specifications)])
        log(f"Managed ACL granted: {target.display_path}")
        return AclOutcome.CHANGED
    except FileNotFoundError:
        return AclOutcome.GONE
    except (OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        log(f"ACL update failed for {target.display_path}: {str(detail).strip()}")
        return AclOutcome.FAILED


def set_managed_access(
    target_or_path: ManagedTarget | Path,
    should_have_access: bool | AccessLevel,
    previous_users: Iterable[str] = (),
    created_default_acl: bool = False,
) -> AclOutcome:
    access = (
        should_have_access
        if isinstance(should_have_access, AccessLevel)
        else AccessLevel.FULL if should_have_access else AccessLevel.NONE
    )
    if isinstance(target_or_path, ManagedTarget):
        return _set_managed_target_access(target_or_path, access, previous_users, created_default_acl)
    path = Path(target_or_path)
    try:
        with ManagedRoot(path.parent) as root, root.open_target(path) as target:
            return _set_managed_target_access(target, access, previous_users, created_default_acl)
    except FileNotFoundError:
        return AclOutcome.GONE
    except (OSError, UnsafePathError) as error:
        log(f"ACL target rejected for {path}: {error}")
        return AclOutcome.FAILED


@dataclass(frozen=True)
class StateRecord:
    ctime_ns: int
    access: AccessLevel
    anchor: Path
    anchor_dev: int
    anchor_ino: int
    target_dev: int
    target_ino: int
    users: tuple[str, ...]
    created_default_acl: bool

    @property
    def cache_key(self) -> tuple[int, AccessLevel, str, int, int, int, int, tuple[str, ...]]:
        return (
            self.ctime_ns, self.access, os.fspath(self.anchor), self.anchor_dev,
            self.anchor_ino, self.target_dev, self.target_ino, self.users,
        )


def record_has_managed_acl(record: StateRecord) -> bool:
    return record.access is not AccessLevel.NONE or record.created_default_acl


def sqlite_identity(value: int) -> int:
    return value if value < 1 << 63 else value - (1 << 64)


def target_identity_changed(record: StateRecord, device: int, inode: int) -> bool:
    return (record.target_dev, record.target_ino) != (
        sqlite_identity(device), sqlite_identity(inode)
    )


class StateStore:
    COLUMNS = {
        "path", "ctime_ns", "access", "anchor", "anchor_dev", "anchor_ino",
        "target_dev", "target_ino", "users", "created_default_acl",
    }
    LEGACY_COLUMNS = {"path", "ctime_ns", "desired", "anchor", "anchor_dev", "anchor_ino"}

    def __init__(self, path: Path | None = None) -> None:
        path = STATE_PATH if path is None else path
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        path.parent.chmod(0o700)
        self.connection = sqlite3.connect(path, timeout=30)
        self.connection.execute("PRAGMA journal_mode=WAL")
        self.connection.execute("PRAGMA synchronous=NORMAL")
        columns = {row[1] for row in self.connection.execute("PRAGMA table_info(paths)")}
        if columns and frozenset(columns) not in {
            frozenset(self.COLUMNS), frozenset(self.LEGACY_COLUMNS)
        }:
            self.connection.close()
            raise ValueError("Unsupported state database schema; refusing to discard revoke provenance")
        if columns == self.LEGACY_COLUMNS:
            legacy_rows = self.connection.execute(
                "SELECT path, ctime_ns, desired, anchor, anchor_dev, anchor_ino FROM paths"
            ).fetchall()
            if any(bool(row[2]) for row in legacy_rows) and not LEGACY_ACL_USERS:
                self.connection.close()
                raise ValueError(
                    "LEGACY_ACL_USERS is required to migrate managed legacy state safely"
                )
            migration_rows: list[tuple[object, ...]] = []
            for path_value, ctime_ns, desired, anchor, anchor_dev, anchor_ino in legacy_rows:
                target_dev = target_ino = 0
                try:
                    metadata = Path(path_value).lstat()
                except FileNotFoundError:
                    if desired:
                        self.connection.close()
                        raise ValueError(
                            f"Cannot migrate managed legacy state for missing path: {path_value}"
                        )
                else:
                    if desired and stat.S_ISLNK(metadata.st_mode):
                        self.connection.close()
                        raise ValueError(
                            f"Cannot migrate managed legacy state for symbolic link: {path_value}"
                        )
                    target_dev = sqlite_identity(metadata.st_dev)
                    target_ino = sqlite_identity(metadata.st_ino)
                migration_rows.append(
                    (
                        path_value, ctime_ns, 2 if desired else 0, anchor, anchor_dev, anchor_ino,
                        target_dev, target_ino, ",".join(LEGACY_ACL_USERS) if desired else "", 0,
                    )
                )
            self.connection.execute("BEGIN IMMEDIATE")
            try:
                self.connection.execute("ALTER TABLE paths RENAME TO paths_legacy")
                self._create_table()
                self.connection.executemany(
                    """
                    INSERT INTO paths(
                        path, ctime_ns, access, anchor, anchor_dev, anchor_ino,
                        target_dev, target_ino, users, created_default_acl
                    )
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """,
                    migration_rows,
                )
                self.connection.execute("DROP TABLE paths_legacy")
                self.connection.commit()
            except BaseException:
                self.connection.rollback()
                self.connection.close()
                raise
        else:
            self._create_table()
            self.connection.commit()

    def _create_table(self) -> None:
        self.connection.execute(
            """
            CREATE TABLE IF NOT EXISTS paths (
                path TEXT PRIMARY KEY,
                ctime_ns INTEGER NOT NULL,
                access INTEGER NOT NULL,
                anchor TEXT NOT NULL,
                anchor_dev INTEGER NOT NULL,
                anchor_ino INTEGER NOT NULL,
                target_dev INTEGER NOT NULL,
                target_ino INTEGER NOT NULL,
                users TEXT NOT NULL,
                created_default_acl INTEGER NOT NULL
            )
            """
        )

    def get(self, path: Path) -> StateRecord | None:
        row = self.connection.execute(
            "SELECT ctime_ns, access, anchor, anchor_dev, anchor_ino, target_dev, target_ino, "
            "users, created_default_acl "
            "FROM paths WHERE path = ?",
            (os.fspath(path),),
        ).fetchone()
        if row is None:
            return None
        return StateRecord(
            int(row[0]), AccessLevel(int(row[1])), Path(row[2]), int(row[3]), int(row[4]),
            int(row[5]), int(row[6]), tuple(item for item in str(row[7]).split(",") if item),
            bool(row[8]),
        )

    def put(
        self, target: ManagedTarget, access: AccessLevel, anchor: ManagedRoot,
        previous: StateRecord | None = None,
    ) -> None:
        metadata = os.fstat(target.fd)
        self.connection.execute(
            """
            INSERT INTO paths(
                path, ctime_ns, access, anchor, anchor_dev, anchor_ino,
                target_dev, target_ino, users, created_default_acl
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(path) DO UPDATE SET ctime_ns=excluded.ctime_ns,
                access=excluded.access, anchor=excluded.anchor,
                anchor_dev=excluded.anchor_dev, anchor_ino=excluded.anchor_ino,
                target_dev=excluded.target_dev, target_ino=excluded.target_ino,
                users=excluded.users, created_default_acl=excluded.created_default_acl
            """,
            (
                os.fspath(target.display_path), metadata.st_ctime_ns, access.value,
                os.fspath(anchor.path), anchor.device, anchor.inode,
                sqlite_identity(metadata.st_dev), sqlite_identity(metadata.st_ino),
                ",".join(ACL_USERS),
                int(
                    False if target.default_acl_cleared
                    else target.created_default_acl or bool(previous and previous.created_default_acl)
                ),
            ),
        )

    def delete(self, path: Path) -> None:
        self.connection.execute("DELETE FROM paths WHERE path = ?", (os.fspath(path),))

    def delete_prefix(self, path: Path) -> None:
        value = os.fspath(path)
        escaped = value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
        self.connection.execute(
            "DELETE FROM paths WHERE path = ? OR path LIKE ? ESCAPE '\\'", (value, escaped + "/%")
        )

    def delete_anchor(self, anchor: Path, anchor_dev: int, anchor_ino: int) -> None:
        self.connection.execute(
            "DELETE FROM paths WHERE anchor = ? AND anchor_dev = ? AND anchor_ino = ?",
            (os.fspath(anchor), anchor_dev, anchor_ino),
        )

    def iter_items(self, batch_size: int = 512) -> Iterator[tuple[Path, StateRecord]]:
        last_path = ""
        while rows := self.connection.execute(
            """
            SELECT path, ctime_ns, access, anchor, anchor_dev, anchor_ino,
                   target_dev, target_ino, users, created_default_acl
            FROM paths WHERE path > ? ORDER BY path LIMIT ?
            """,
            (last_path, batch_size),
        ).fetchall():
            for (
                path, ctime_ns, access, anchor, anchor_dev, anchor_ino,
                target_dev, target_ino, users, created_default_acl,
            ) in rows:
                last_path = str(path)
                yield Path(path), StateRecord(
                    int(ctime_ns), AccessLevel(int(access)), Path(anchor), int(anchor_dev), int(anchor_ino),
                    int(target_dev), int(target_ino),
                    tuple(item for item in str(users).split(",") if item), bool(created_default_acl),
                )

    def commit(self) -> None:
        self.connection.commit()

    def close(self) -> None:
        self.connection.commit()
        self.connection.close()


@dataclass
class ReconcileStats:
    visited: int = 0
    acl_reads: int = 0
    changed: int = 0
    failed: int = 0
    elapsed: float = 0.0

    def absorb(self, other: "ReconcileStats") -> None:
        self.visited += other.visited
        self.acl_reads += other.acl_reads
        self.changed += other.changed
        self.failed += other.failed


def choose_allowed_root(path: Path, roots: Iterable[Path]) -> Path:
    candidates = [root for root in roots if path == root or path.is_relative_to(root)]
    if not candidates:
        raise UnsafePathError(f"No managed root contains {path}")
    return max(candidates, key=lambda item: len(item.parts))


def reconcile_path(
    path: Path,
    desired: AccessLevel,
    state: StateStore,
    force: bool = False,
    allowed_roots: Iterable[Path] | None = None,
    managed_root: ManagedRoot | None = None,
) -> ReconcileStats:
    stats = ReconcileStats(visited=1)
    if isinstance(desired, bool):
        desired = AccessLevel.FULL if desired else AccessLevel.NONE
    if managed_root is None:
        try:
            root_path = choose_allowed_root(path, allowed_roots or [path.parent])
            with ManagedRoot(root_path) as opened:
                return reconcile_path(path, desired, state, force, managed_root=opened)
        except FileNotFoundError:
            return stats
        except (OSError, UnsafePathError) as error:
            log(f"ACL target rejected for {path}: {error}")
            stats.failed = 1
            return stats
    previous = state.get(path)
    try:
        with managed_root.open_target(path) as target:
            if stat.S_ISLNK(target.mode):
                if previous is not None and record_has_managed_acl(previous):
                    log(f"Managed path became a symbolic link; retaining revoke state: {path}")
                    stats.failed = 1
                else:
                    state.delete(path)
                return stats
            if not (stat.S_ISDIR(target.mode) or stat.S_ISREG(target.mode)):
                desired = AccessLevel.NONE
            metadata = os.fstat(target.fd)
            if previous is not None and record_has_managed_acl(previous) and target_identity_changed(
                previous, metadata.st_dev, metadata.st_ino
            ):
                log(f"Managed path identity changed; retaining revoke state: {path}")
                stats.failed = 1
                return stats
            current_key = (
                metadata.st_ctime_ns, desired, os.fspath(managed_root.path),
                managed_root.device, managed_root.inode,
                sqlite_identity(metadata.st_dev), sqlite_identity(metadata.st_ino),
                tuple(ACL_USERS),
            )
            if not force and previous is not None and previous.cache_key == current_key:
                return stats
            stats.acl_reads = 1
            outcome = set_managed_access(
                target,
                desired,
                previous.users if previous else (),
                previous.created_default_acl if previous else False,
            )
            if outcome in {AclOutcome.UNCHANGED, AclOutcome.CHANGED}:
                state.put(target, desired, managed_root, previous)
                stats.changed = int(outcome is AclOutcome.CHANGED)
            elif outcome is AclOutcome.GONE:
                log(f"ACL target disappeared; retaining state for safe recovery: {path}")
            else:
                stats.failed = 1
    except FileNotFoundError:
        log(f"ACL target disappeared; retaining state for safe recovery: {path}")
    except (OSError, UnsafePathError) as error:
        log(f"ACL target rejected for {path}: {error}")
        stats.failed = 1
    return stats


def desired_for_matcher(path: Path, root: Path, matcher: IgnoreMatcher, directory: bool) -> AccessLevel:
    if path == root:
        return AccessLevel.FULL
    relative = path.relative_to(root).as_posix()
    if matcher.is_control_path(relative):
        return AccessLevel.NONE
    if directory:
        return matcher.directory_access(relative)
    return AccessLevel.FULL if matcher.is_included(relative) else AccessLevel.NONE


def walk_paths(
    root: Path, stats: ReconcileStats | None = None, managed_root: ManagedRoot | None = None
) -> Iterator[Path]:
    if not root.exists() and not root.is_symlink():
        return
    if not root.is_dir() or root.is_symlink():
        yield root
        return
    def record_error(error: OSError) -> None:
        log(f"Tree scan failed: {error}")
        if stats is not None:
            stats.failed += 1

    for directory, directory_names, file_names in os.walk(root, followlinks=False, onerror=record_error):
        directory_path = Path(directory)
        safe_directories: list[str] = []
        for name in directory_names:
            child = directory_path / name
            if child.is_symlink():
                continue
            if managed_root is not None:
                try:
                    with managed_root.open_target(child):
                        pass
                except (OSError, UnsafePathError) as error:
                    record_error(OSError(f"Cannot enter {child}: {error}"))
                    continue
            safe_directories.append(name)
        directory_names[:] = safe_directories
        yield directory_path
        for file_name in file_names:
            file_path = directory_path / file_name
            if not file_path.is_symlink():
                yield file_path


def reconcile_tree(
    root: Path,
    desired_for_path: Callable[[Path, bool], bool],
    state: StateStore,
    managed_root: ManagedRoot,
    force: bool = False,
) -> ReconcileStats:
    stats = ReconcileStats()
    for path in walk_paths(root, stats, managed_root):
        try:
            directory = path.is_dir()
        except OSError:
            continue
        stats.absorb(
            reconcile_path(path, desired_for_path(path, directory), state, force, managed_root=managed_root)
        )
    state.commit()
    return stats


def reconcile_root(root: Path, matcher: IgnoreMatcher, state: StateStore, force: bool = False) -> ReconcileStats:
    root = Path(os.path.abspath(root))
    started = time.monotonic()
    with ManagedRoot(root) as managed_root:
        stats = reconcile_tree(
            root, lambda path, directory: desired_for_matcher(path, root, matcher, directory),
            state, managed_root, force,
        )
    stats.elapsed = time.monotonic() - started
    return stats


def compact_roots(roots: Iterable[Path]) -> list[Path]:
    compacted: list[Path] = []
    for root in sorted(set(roots), key=lambda item: (len(item.parts), os.fspath(item))):
        if not any(root == parent or root.is_relative_to(parent) for parent in compacted):
            compacted.append(root)
    return compacted


def policies_for_path(path: Path, policies: Iterable[FolderPolicy]) -> list[FolderPolicy]:
    return [policy for policy in policies if path == policy.root or path.is_relative_to(policy.root)]


def desired_for_policies(path: Path, directory: bool, policies: list[FolderPolicy]) -> AccessLevel:
    applicable = policies_for_path(path, policies)
    for policy in applicable:
        if path != policy.root and policy.matcher.is_control_path(path.relative_to(policy.root).as_posix()):
            return AccessLevel.NONE
    levels = [desired_for_matcher(path, policy.root, policy.matcher, directory) for policy in applicable]
    return max(levels, key=lambda item: item.value, default=AccessLevel.NONE)


def reconcile_removed_state(
    state: StateStore, policies: list[FolderPolicy], stats: ReconcileStats, force: bool
) -> None:
    invalid_anchors: set[tuple[Path, int, int]] = set()
    for path, record in state.iter_items():
        if policies_for_path(path, policies):
            try:
                metadata = path.lstat()
            except FileNotFoundError:
                if record_has_managed_acl(record):
                    stats.failed += 1
                    log(f"Managed path is missing; retaining revoke state: {path}")
                else:
                    state.delete(path)
            else:
                if stat.S_ISLNK(metadata.st_mode):
                    if record_has_managed_acl(record):
                        stats.failed += 1
                        log(f"Managed path became a symbolic link; retaining revoke state: {path}")
                    else:
                        state.delete(path)
            continue
        anchor = record.anchor
        anchor_key = (anchor, record.anchor_dev, record.anchor_ino)
        if anchor_key in invalid_anchors:
            continue
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            if record.access is AccessLevel.NONE and not record.created_default_acl:
                state.delete(path)
            else:
                stats.failed += 1
                log(f"Former managed path is missing; retaining revoke state: {path}")
            continue
        if stat.S_ISLNK(metadata.st_mode):
            if record.access is AccessLevel.NONE and not record.created_default_acl:
                state.delete(path)
            else:
                stats.failed += 1
                log(f"Former managed path became a symbolic link; retaining revoke state: {path}")
            continue
        try:
            with ManagedRoot(anchor) as managed_root:
                if (managed_root.device, managed_root.inode) != (record.anchor_dev, record.anchor_ino):
                    invalid_anchors.add(anchor_key)
                    stats.failed += 1
                    log(
                        f"Former managed root identity changed; cached ACL cleanup was quarantined: {anchor}"
                    )
                    continue
                result = reconcile_path(path, AccessLevel.NONE, state, force, managed_root=managed_root)
                stats.absorb(result)
                if not result.failed:
                    state.delete(path)
        except (OSError, UnsafePathError) as error:
            log(f"Cannot safely revoke ACL under former root {anchor}: {error}")
            stats.failed += 1


def reconcile_all(policies: list[FolderPolicy], state: StateStore, force: bool = False) -> ReconcileStats:
    started = time.monotonic()
    stats = ReconcileStats()
    roots = compact_roots(policy.root for policy in policies)
    for root in roots:
        if not root.is_dir():
            log(f"Configured folder is not available yet: {root}")
            stats.failed += 1
            continue
        try:
            with ManagedRoot(root) as managed_root:
                stats.absorb(
                    reconcile_tree(
                        root,
                        lambda path, directory: desired_for_policies(path, directory, policies),
                        state, managed_root, force,
                    )
                )
        except (OSError, UnsafePathError) as error:
            log(f"Cannot safely scan managed root {root}: {error}")
            stats.failed += 1
    reconcile_removed_state(state, policies, stats, force)
    state.commit()
    stats.elapsed = time.monotonic() - started
    log(
        f"Full reconciliation complete: folders={len(policies)} roots={len(roots)} "
        f"visited={stats.visited} acl_reads={stats.acl_reads} changed={stats.changed} "
        f"failed={stats.failed} elapsed={stats.elapsed:.3f}s"
    )
    return stats


def reconcile_event_path(path: Path, policies: list[FolderPolicy], state: StateStore) -> ReconcileStats:
    path = Path(os.path.abspath(path))
    applicable = policies_for_path(path, policies)
    if not applicable:
        state.delete_prefix(path)
        state.commit()
        return ReconcileStats()
    root = choose_allowed_root(path, compact_roots(policy.root for policy in applicable))
    if path.is_dir() and not path.is_symlink():
        with ManagedRoot(root) as managed_root:
            return reconcile_tree(
                path, lambda item, directory: desired_for_policies(item, directory, policies),
                state, managed_root,
            )
    stats = reconcile_path(path, desired_for_policies(path, False, policies), state, allowed_roots=[root])
    state.commit()
    return stats


def is_control_event(path: Path, policies: list[FolderPolicy]) -> bool:
    for policy in policies_for_path(path, policies):
        if path != policy.root and policy.matcher.is_control_path(path.relative_to(policy.root).as_posix()):
            return True
    return False


def seconds_until_next_refresh() -> float:
    now = dt.datetime.now(dt.timezone.utc)
    next_hour = ((now.hour // FULL_REFRESH_HOURS) + 1) * FULL_REFRESH_HOURS
    next_run = (
        (now + dt.timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
        if next_hour >= 24
        else now.replace(hour=next_hour, minute=0, second=0, microsecond=0)
    )
    log(f"Next full reconciliation: {next_run.strftime('%Y-%m-%dT%H:%M:%SZ')}")
    return max(0.0, (next_run - now).total_seconds())


@dataclass
class RetryBackoff:
    initial_seconds: float = 5
    maximum_seconds: float = 300
    due_at: float | None = None
    next_delay: float = field(init=False)

    def __post_init__(self) -> None:
        self.next_delay = self.initial_seconds

    def trigger(self, now: float) -> None:
        self.due_at = now

    def failed(self, now: float) -> None:
        if self.due_at is not None and now < self.due_at:
            return
        self.due_at = now + self.next_delay
        self.next_delay = min(self.maximum_seconds, self.next_delay * 2)

    def succeeded(self) -> None:
        self.due_at = None
        self.next_delay = self.initial_seconds

    def is_due(self, now: float) -> bool:
        return self.due_at is not None and now >= self.due_at


def events_require_full_reconciliation(events: set[str]) -> bool:
    return bool({"Q_OVERFLOW", "DELETE_SELF", "MOVE_SELF"} & events)


def folder_event_reconciliation_allowed(policy_dirty: bool) -> bool:
    return not policy_dirty


def record_reconciliation_result(stats: ReconcileStats, retry: RetryBackoff, now: float) -> bool:
    if stats.failed:
        retry.failed(now)
        assert retry.due_at is not None
        log(f"ACL reconciliation will be retried after {retry.due_at - now:.0f}s")
        return True
    retry.succeeded()
    return False


@dataclass
class Watcher:
    kind: str
    process: subprocess.Popen[bytes]
    buffer: bytearray = field(default_factory=bytearray)


def start_inotify(kind: str, paths: list[Path], recursive: bool) -> Watcher | None:
    if not paths:
        return None
    command = ["inotifywait", "--monitor", "--quiet"]
    if recursive:
        command.append("--recursive")
    for event in INOTIFY_EVENTS:
        command.extend(("--event", event))
    command.extend(("--format", "%e|%w%f"))
    command.extend(os.fspath(path) for path in paths)
    return Watcher(kind, subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0))


def start_watchers(
    config_path: Path, allowlist_path: Path, policies: list[FolderPolicy]
) -> tuple[selectors.BaseSelector, list[Watcher]]:
    selector = selectors.DefaultSelector()
    existing = [root for root in compact_roots(policy.root for policy in policies) if root.is_dir()]
    nested_mounts = nested_mount_points(existing)
    if nested_mounts:
        selector.close()
        raise UnsafePathError(
            "Managed roots contain nested mounts: " + ", ".join(map(os.fspath, nested_mounts))
        )
    policy_parents = sorted({config_path.parent, allowlist_path.parent}, key=os.fspath)
    candidates = [
        start_inotify("policy", policy_parents, False),
        start_inotify("folders", existing, True),
    ]
    watchers = [watcher for watcher in candidates if watcher is not None]
    for watcher in watchers:
        assert watcher.process.stdout is not None
        selector.register(watcher.process.stdout, selectors.EVENT_READ, watcher)
    return selector, watchers


def stop_watchers(selector: selectors.BaseSelector, watchers: list[Watcher]) -> None:
    for watcher in watchers:
        if watcher.process.stdout is not None:
            try:
                selector.unregister(watcher.process.stdout)
            except (KeyError, ValueError):
                pass
        if watcher.process.poll() is None:
            watcher.process.terminate()
    for watcher in watchers:
        if watcher.process.poll() is None:
            try:
                watcher.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                watcher.process.kill()
                watcher.process.wait(timeout=5)
    selector.close()


def parse_event(line: bytes | bytearray) -> tuple[set[str], Path] | None:
    payload = bytes(line)
    try:
        raw_events, raw_path = payload.split(b"|", 1)
    except ValueError:
        if payload:
            log(f"inotifywait: {os.fsdecode(payload)}")
        return None
    return set(os.fsdecode(raw_events).split(",")), Path(os.fsdecode(raw_path))


def nested_mount_points(roots: Iterable[Path]) -> list[Path]:
    normalized_roots = [Path(os.path.abspath(root)) for root in roots]
    mount_points: list[Path] = []
    for line in Path("/proc/self/mountinfo").read_text(encoding="utf-8").splitlines():
        fields = line.split()
        if len(fields) < 5:
            raise ValueError("Malformed /proc/self/mountinfo entry")
        decoded = re.sub(
            r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), fields[4]
        )
        mount_point = Path(os.path.abspath(decoded))
        if any(mount_point != root and mount_point.is_relative_to(root) for root in normalized_roots):
            mount_points.append(mount_point)
    return sorted(set(mount_points), key=os.fspath)


def daemon() -> int:
    home = syncthing_home()
    config_path = locate_config(home)
    policies = load_policies(config_path, home)
    state = StateStore()
    tree_retry = RetryBackoff(maximum_seconds=3600)
    tree_dirty = record_reconciliation_result(
        reconcile_all(policies, state), tree_retry, time.monotonic()
    )
    selector, watchers = start_watchers(config_path, ALLOWLIST_PATH, policies)
    policy_retry, watcher_retry = RetryBackoff(), RetryBackoff()
    policy_dirty = watchers_dirty = False
    next_full = time.monotonic() + seconds_until_next_refresh()
    next_missing = time.monotonic() + MISSING_FOLDER_RECHECK_SECONDS

    def request_stop(_signal: int, _frame: object) -> None:
        raise StopRequested

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    try:
        while True:
            now = time.monotonic()
            roots = compact_roots(policy.root for policy in policies)
            has_missing = any(not root.is_dir() for root in roots)
            deadlines = [next_full]
            if has_missing:
                deadlines.append(next_missing)
            if policy_dirty and policy_retry.due_at is not None:
                deadlines.append(policy_retry.due_at)
            if watchers_dirty and watcher_retry.due_at is not None:
                deadlines.append(watcher_retry.due_at)
            if tree_dirty and tree_retry.due_at is not None:
                deadlines.append(tree_retry.due_at)
            ready = selector.select(max(0.0, min(deadlines) - now))
            now = time.monotonic()
            if now >= next_full:
                policy_dirty = tree_dirty = True
                policy_retry.trigger(now)
                next_full = now + seconds_until_next_refresh()
            if has_missing and now >= next_missing:
                tree_dirty = watchers_dirty = True
                tree_retry.trigger(now)
                watcher_retry.trigger(now)
                next_missing = now + MISSING_FOLDER_RECHECK_SECONDS

            watcher_failed = False
            pending_events: list[tuple[Watcher, set[str], Path]] = []
            for key, _mask in sorted(ready, key=lambda item: item[0].data.kind != "policy"):
                watcher: Watcher = key.data
                chunk = os.read(key.fileobj.fileno(), 65536)
                if not chunk:
                    log(f"{watcher.kind} watcher exited; entering retry backoff")
                    watcher_failed = tree_dirty = True
                    continue
                watcher.buffer.extend(chunk)
                while b"\n" in watcher.buffer:
                    line, _, remainder = watcher.buffer.partition(b"\n")
                    watcher.buffer = bytearray(remainder)
                    parsed = parse_event(line)
                    if parsed is None:
                        continue
                    events, event_path = parsed
                    event_path = Path(os.path.abspath(event_path))
                    pending_events.append((watcher, events, event_path))

            for watcher, events, event_path in pending_events:
                if watcher.kind == "policy" and event_path in {config_path, ALLOWLIST_PATH}:
                    policy_dirty = True
                    policy_retry.trigger(now)
                elif watcher.kind == "folders" and is_control_event(event_path, policies) and (
                    {"CLOSE_WRITE", "MOVED_TO", "CREATE", "DELETE"} & events
                ):
                    policy_dirty = True
                    policy_retry.trigger(now)

            for watcher, events, event_path in pending_events:
                if events_require_full_reconciliation(events):
                    tree_dirty = True
                    tree_retry.trigger(now)
                if "Q_OVERFLOW" in events:
                    continue
                if watcher.kind == "policy" or watcher.kind == "folders" and is_control_event(
                    event_path, policies
                ) and ({"CLOSE_WRITE", "MOVED_TO", "CREATE", "DELETE"} & events):
                    continue
                if watcher.kind == "folders":
                    if not folder_event_reconciliation_allowed(policy_dirty):
                        tree_dirty = True
                        tree_retry.trigger(now)
                        continue
                    event_stats = reconcile_event_path(event_path, policies, state)
                    if event_stats.failed:
                        tree_dirty = True
                        tree_retry.failed(now)

            if watcher_failed:
                stop_watchers(selector, watchers)
                selector, watchers = selectors.DefaultSelector(), []
                watchers_dirty = True
                tree_retry.trigger(now)
                watcher_retry.failed(now)
            if policy_dirty and policy_retry.is_due(now):
                try:
                    config_path = locate_config(home)
                    policies = load_policies(config_path, home)
                except (OSError, ET.ParseError, ValueError, KeyError) as error:
                    log(f"Cannot reload Syncthing policy; retrying: {error}")
                    policy_retry.failed(now)
                else:
                    policy_dirty = False
                    policy_retry.succeeded()
                    tree_dirty = watchers_dirty = True
                    tree_retry.trigger(now)
                    if watchers:
                        stop_watchers(selector, watchers)
                        selector, watchers = selectors.DefaultSelector(), []
                    watcher_retry.trigger(now)
            if tree_dirty and not policy_dirty and tree_retry.is_due(now):
                tree_dirty = record_reconciliation_result(
                    reconcile_all(policies, state), tree_retry, now
                )
            if watchers_dirty and watcher_retry.is_due(now):
                try:
                    replacement_selector, replacement_watchers = start_watchers(
                        config_path, ALLOWLIST_PATH, policies
                    )
                except OSError as error:
                    log(f"Cannot start filesystem watchers; retrying: {error}")
                    watcher_retry.failed(now)
                else:
                    selector, watchers = replacement_selector, replacement_watchers
                    watchers_dirty = False
                    watcher_retry.succeeded()
    except StopRequested:
        pass
    finally:
        stop_watchers(selector, watchers)
        state.close()
    return 0


def scan_once(force: bool = False) -> int:
    home = syncthing_home()
    policies = load_policies(locate_config(home), home)
    state = StateStore()
    try:
        return 1 if reconcile_all(policies, state, force).failed else 0
    finally:
        state.close()


def revoke_all_recorded(force: bool = True) -> int:
    state = StateStore()
    stats = ReconcileStats()
    started = time.monotonic()
    try:
        reconcile_removed_state(state, [], stats, force)
        state.commit()
        stats.elapsed = time.monotonic() - started
        remaining = sum(1 for _item in state.iter_items())
        log(
            f"Recorded ACL revocation complete: changed={stats.changed} "
            f"failed={stats.failed} unresolved={remaining} elapsed={stats.elapsed:.3f}s"
        )
        return 1 if stats.failed or remaining else 0
    finally:
        state.close()


def main() -> int:
    try:
        settings = parse_runtime_settings()
        apply_runtime_settings(settings)
        pwd.getpwnam(SYNCTHING_USER)
        for user in ACL_USERS:
            pwd.getpwnam(user)
        if settings.revoke_all:
            return revoke_all_recorded()
        return scan_once(settings.force) if settings.scan else daemon()
    except (
        OSError, UnsafePathError, ET.ParseError, ValueError, KeyError,
        subprocess.CalledProcessError,
    ) as error:
        log(f"Fatal error: {error}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
