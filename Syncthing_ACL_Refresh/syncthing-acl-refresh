@dataclass(frozen=True)
class RuntimeSettings:
    syncthing_user: str
    acl_users: tuple[str, ...]
    config_path: Path | None
    state_path: Path
    certificate_path: Path
    allowlist_path: Path
    force: bool
    revoke_all: bool


def _absolute_path(value: str, variable: str) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        raise ValueError(f"{variable} must be an absolute path")
    return path


def _managed_users(value: str) -> tuple[str, ...]:
    users: list[str] = []
    for item in value.split(","):
        user = item.strip()
        if not user:
            continue
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*\$?", user):
            raise ValueError(f"Invalid managed ACL user: {user}")
        if user not in users:
            users.append(user)
    if not users:
        raise ValueError("At least one managed ACL user is required")
    return tuple(users)


def read_environment_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line_number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        name, separator, value = line.partition("=")
        name = name.strip()
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", name):
            raise ValueError(f"Invalid environment entry at {path}:{line_number}")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        values[name] = value
    return values


def parse_runtime_settings(
    arguments: Sequence[str] | None = None,
    environment: Mapping[str, str] | None = None,
) -> RuntimeSettings:
    source_env = os.environ if environment is None else environment
    pre_parser = argparse.ArgumentParser(add_help=False)
    pre_parser.add_argument("--env-file")
    pre_parsed, _unknown = pre_parser.parse_known_args(arguments)
    env = dict(source_env)
    if pre_parsed.env_file:
        env.update(read_environment_file(_absolute_path(pre_parsed.env_file, "env-file")))
    parser = argparse.ArgumentParser(description="Reconcile POSIX ACLs with Syncthing folder policy")
    parser.add_argument("--env-file", help="load KEY=VALUE settings for a direct invocation")
    parser.add_argument("--syncthing-user", default=env.get("SYNCTHING_USER", "syncthing"))
    parser.add_argument("--users", default=env.get("ACL_USERS", ""))
    parser.add_argument("--config", default=env.get("SYNCTHING_CONFIG", ""))
    parser.add_argument("--state", default=env.get("STATE_PATH", "/var/lib/syncthing-acl-refresh/state.sqlite3"))
    parser.add_argument("--certificate", default=env.get("TLS_CERTIFICATE", "/etc/syncthing-acl-refresh/https-cert.pem"))
    parser.add_argument("--allowlist", default=env.get("FOLDER_ALLOWLIST", "/etc/syncthing-acl-refresh/folders.conf"))
    parser.add_argument("--force", action="store_true", help="inspect ACLs even when cached metadata is unchanged")
    parser.add_argument("--revoke-all", action="store_true", help="remove ACL entries recorded in state and exit")
    parsed = parser.parse_args(arguments)

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*\$?", parsed.syncthing_user):
        raise ValueError("Invalid Syncthing service user")
    return RuntimeSettings(
        syncthing_user=parsed.syncthing_user,
        acl_users=_managed_users(parsed.users),
        config_path=_absolute_path(parsed.config, "config") if parsed.config else None,
        state_path=_absolute_path(parsed.state, "state"),
        certificate_path=_absolute_path(parsed.certificate, "certificate"),
        allowlist_path=_absolute_path(parsed.allowlist, "allowlist"),
        force=parsed.force,
        revoke_all=parsed.revoke_all,
    )


def apply_runtime_settings(settings: RuntimeSettings) -> None:
    global SYNCTHING_USER, ACL_USERS, CONFIG_PATH, STATE_PATH, ALLOWLIST_PATH
    global PINNED_CERTIFICATE_PATH
    SYNCTHING_USER = settings.syncthing_user
    ACL_USERS = settings.acl_users
    CONFIG_PATH = settings.config_path
    STATE_PATH = settings.state_path
    PINNED_CERTIFICATE_PATH = settings.certificate_path
    ALLOWLIST_PATH = settings.allowlist_path


