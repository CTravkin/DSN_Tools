{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CTravkin/DSN_Tools/Windows_Audio_Profile/audio-profile.schema.json",
  "title": "Windows Audio Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "devices"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "exportedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "binding": { "const": "strict" } }, "required": ["binding"] },
          "then": { "required": ["machineIdSha256"] }
        }
      ],
      "properties": {
        "computerName": { "type": "string" },
        "machineIdSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "binding": { "enum": ["strict", "none"] }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/device" }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "render": { "$ref": "#/$defs/flowPriority" },
        "capture": { "$ref": "#/$defs/flowPriority" }
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "match"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": true },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flow"],
          "properties": {
            "flow": { "enum": ["render", "capture"] },
            "endpointId": { "type": "string", "pattern": "^\\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\}$" },
            "stableId": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "containerId": { "type": "string" },
            "deviceInstanceId": { "type": "string" },
            "hardwareIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "driverProvider": { "type": "string" },
            "driverIdentity": { "type": "string" }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "icon": { "type": "string", "minLength": 1 },
            "enabled": { "type": "boolean" },
            "volume": { "$ref": "#/$defs/volume" },
            "format": { "$ref": "#/$defs/format" }
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "decibels": { "type": "number" },
        "muted": { "type": "boolean" }
      },
      "not": { "required": ["percent", "decibels"] }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "sampleRateHz", "bitsPerSample"],
      "properties": {
        "channels": { "type": "integer", "minimum": 1 },
        "sampleRateHz": { "type": "integer", "minimum": 1 },
        "bitsPerSample": { "type": "integer", "minimum": 1 },
        "validBitsPerSample": { "type": "integer", "minimum": 1 },
        "encoding": { "enum": ["pcm", "ieeeFloat"] },
        "channelMask": { "type": "integer", "minimum": 0 },
        "extensible": { "type": "boolean" }
      }
    },
    "priorityOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leastToMostPreferred"],
      "properties": {
        "leastToMostPreferred": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "flowPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allRoles"],
      "properties": {
        "allRoles": { "$ref": "#/$defs/priorityOrder" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "console": { "$ref": "#/$defs/priorityOrder" },
            "multimedia": { "$ref": "#/$defs/priorityOrder" },
            "communications": { "$ref": "#/$defs/priorityOrder" }
          }
        }
      }
    }
  }
}
