using System;
using System.Diagnostics;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using System.Threading;
using System.Windows.Automation;
using System.Windows.Forms;

internal static class TrayLauncher
{
    private const string TargetPath = __TARGET_PATH__;
    private const string FixedArguments = __ARGUMENTS__;
    private const string ProcessName = __PROCESS_NAME__;
    private const string WindowClass = __WINDOW_CLASS__;
    private const string WindowTitle = __WINDOW_TITLE__;
    private const string TrayIconName = __TRAY_ICON_NAME__;
    private const string TrayMenuItemName = __TRAY_MENU_ITEM_NAME__;
    private const int RetryCount = __RETRY_COUNT__;
    private const int RetryDelayMilliseconds = __RETRY_DELAY__;
    private delegate bool EnumWindowsCallback(IntPtr window, IntPtr parameter);

    [DllImport("user32.dll")] private static extern bool EnumWindows(EnumWindowsCallback callback, IntPtr parameter);
    [DllImport("user32.dll")] private static extern uint GetWindowThreadProcessId(IntPtr window, out uint processId);
    [DllImport("user32.dll", CharSet=CharSet.Unicode)] private static extern int GetWindowText(IntPtr window, StringBuilder text, int count);
    [DllImport("user32.dll", CharSet=CharSet.Unicode)] private static extern int GetClassName(IntPtr window, StringBuilder text, int count);
    [DllImport("user32.dll")] private static extern bool IsWindowVisible(IntPtr window);
    [DllImport("user32.dll")] private static extern bool IsIconic(IntPtr window);
    [DllImport("user32.dll")] private static extern bool ShowWindowAsync(IntPtr window, int command);
    [DllImport("user32.dll")] private static extern bool BringWindowToTop(IntPtr window);
    [DllImport("user32.dll")] private static extern bool SetForegroundWindow(IntPtr window);
    [DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] private static extern uint GetCurrentThreadId();
    [DllImport("user32.dll")] private static extern bool AttachThreadInput(uint attach, uint attachTo, bool value);
    [DllImport("user32.dll")] private static extern bool SetCursorPos(int x, int y);
    [DllImport("user32.dll")] private static extern bool GetCursorPos(out Point point);
    [DllImport("user32.dll", SetLastError=true)] private static extern uint SendInput(uint count, Input[] inputs, int size);

    [StructLayout(LayoutKind.Sequential)] private struct Point { public int X; public int Y; }
    [StructLayout(LayoutKind.Sequential)] private struct MouseInput { public int X; public int Y; public uint Data; public uint Flags; public uint Time; public UIntPtr ExtraInfo; }
    [StructLayout(LayoutKind.Sequential)] private struct Input { public uint Type; public MouseInput Mouse; }

    private static string Json(string value)
    {
        StringBuilder result = new StringBuilder("\"");
        foreach (char character in value ?? "")
        {
            switch (character)
            {
                case '\"': result.Append("\\\""); break;
                case '\\': result.Append("\\\\"); break;
                case '\b': result.Append("\\b"); break;
                case '\f': result.Append("\\f"); break;
                case '\n': result.Append("\\n"); break;
                case '\r': result.Append("\\r"); break;
                case '\t': result.Append("\\t"); break;
                default:
                    if (character < 0x20 || character == 0x2028 || character == 0x2029 || Char.IsSurrogate(character))
                        result.Append("\\u").Append(((int)character).ToString("x4"));
                    else result.Append(character);
                    break;
            }
        }
        return result.Append('\"').ToString();
    }

    private static bool Matches(IntPtr window)
    {
        uint processId; GetWindowThreadProcessId(window, out processId);
        try { if (!String.Equals(Process.GetProcessById((int)processId).ProcessName, ProcessName, StringComparison.OrdinalIgnoreCase)) return false; } catch { return false; }
        StringBuilder className = new StringBuilder(256); GetClassName(window, className, className.Capacity);
        if (WindowClass.Length > 0 && !String.Equals(className.ToString(), WindowClass, StringComparison.OrdinalIgnoreCase)) return false;
        StringBuilder title = new StringBuilder(1024); GetWindowText(window, title, title.Capacity);
        return title.Length > 0 && (WindowTitle.Length == 0 || title.ToString().IndexOf(WindowTitle, StringComparison.OrdinalIgnoreCase) >= 0);
    }

    private static IntPtr FindWindow()
    {
        IntPtr found = IntPtr.Zero;
        EnumWindows(delegate(IntPtr window, IntPtr parameter) { if (Matches(window)) { found=window; return false; } return true; }, IntPtr.Zero);
        return found;
    }

    private static bool Activate(IntPtr window)
    {
        if (window == IntPtr.Zero) return false;
        ShowWindowAsync(window, IsIconic(window) ? 9 : 5);
        IntPtr foreground = GetForegroundWindow();
        uint ignored;
        uint foregroundThread = foreground == IntPtr.Zero ? 0 : GetWindowThreadProcessId(foreground, out ignored);
        uint currentThread = GetCurrentThreadId();
        bool attached = foregroundThread != 0 && foregroundThread != currentThread && AttachThreadInput(currentThread, foregroundThread, true);
        try { BringWindowToTop(window); return SetForegroundWindow(window); }
        finally { if (attached) AttachThreadInput(currentThread, foregroundThread, false); }
    }

    private static AutomationElement FindTrayIcon()
    {
        Condition trayWindow = new OrCondition(
            new PropertyCondition(AutomationElement.ClassNameProperty, "Shell_TrayWnd"),
            new PropertyCondition(AutomationElement.ClassNameProperty, "NotifyIconOverflowWindow"));
        Condition icon = new AndCondition(
            new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Button),
            new PropertyCondition(AutomationElement.NameProperty, TrayIconName));
        AutomationElementCollection roots = AutomationElement.RootElement.FindAll(TreeScope.Children, trayWindow);
        foreach (AutomationElement root in roots)
        {
            AutomationElement match = root.FindFirst(TreeScope.Descendants, icon);
            if (match != null) return match;
        }
        return null;
    }

    private static AutomationElement FindMenuItem(System.Windows.Point origin)
    {
        Condition menus = new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.Menu);
        Condition itemCondition = new AndCondition(
            new PropertyCondition(AutomationElement.ControlTypeProperty, ControlType.MenuItem),
            new PropertyCondition(AutomationElement.NameProperty, TrayMenuItemName));
        AutomationElement best = null;
        double bestDistance = Double.MaxValue;
        foreach (AutomationElement menu in AutomationElement.RootElement.FindAll(TreeScope.Descendants, menus))
        {
            AutomationElement item = menu.FindFirst(TreeScope.Descendants, itemCondition);
            if (item == null || !item.Current.IsEnabled || item.Current.IsOffscreen) continue;
            System.Windows.Rect rectangle = menu.Current.BoundingRectangle;
            double dx = origin.X < rectangle.Left ? rectangle.Left-origin.X : (origin.X > rectangle.Right ? origin.X-rectangle.Right : 0);
            double dy = origin.Y < rectangle.Top ? rectangle.Top-origin.Y : (origin.Y > rectangle.Bottom ? origin.Y-rectangle.Bottom : 0);
            double distance = dx*dx + dy*dy;
            if (distance < bestDistance) { best=item; bestDistance=distance; }
        }
        return best;
    }

    private static bool RightClick(int x, int y)
    {
        Point original;
        if (!GetCursorPos(out original) || !SetCursorPos(x, y)) return false;
        try
        {
            Input[] inputs = {
                new Input { Type=0, Mouse=new MouseInput { Flags=0x0008 } },
                new Input { Type=0, Mouse=new MouseInput { Flags=0x0010 } }
            };
            return SendInput((uint)inputs.Length, inputs, Marshal.SizeOf(typeof(Input))) == (uint)inputs.Length;
        }
        finally { SetCursorPos(original.X, original.Y); }
    }

    private static bool OpenFromTray()
    {
        for (int attempt=0; attempt<RetryCount; attempt++)
        {
            try
            {
                AutomationElement icon = FindTrayIcon();
                if (icon != null)
                {
                    System.Windows.Point point;
                    if (icon.TryGetClickablePoint(out point) && RightClick((int)point.X, (int)point.Y))
                    {
                        Thread.Sleep(RetryDelayMilliseconds);
                        AutomationElement item = FindMenuItem(point);
                        if (item != null)
                        {
                            object pattern;
                            if (item.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
                            {
                                ((InvokePattern)pattern).Invoke();
                                for (int wait=0; wait<RetryCount; wait++) { Thread.Sleep(RetryDelayMilliseconds); IntPtr window=FindWindow(); if (window!=IntPtr.Zero) return Activate(window); }
                            }
                        }
                    }
                }
            }
            catch (ElementNotAvailableException) { }
            catch (InvalidOperationException) { }
            Thread.Sleep(RetryDelayMilliseconds);
        }
        return false;
    }

    private static string DetermineAction(bool hasWindow, bool hasTrayIcon) { return hasWindow ? "activate" : (hasTrayIcon ? "open-tray" : "launch"); }

    [STAThread]
    private static int Main(string[] args)
    {
        string expandedTarget = Environment.ExpandEnvironmentVariables(TargetPath);
        if (args.Length==1 && String.Equals(args[0],"--print-config",StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine("{\"targetPath\":"+Json(expandedTarget)+",\"arguments\":"+Json(FixedArguments)+",\"processName\":"+Json(ProcessName)+",\"windowClass\":"+Json(WindowClass)+",\"windowTitle\":"+Json(WindowTitle)+",\"trayIconName\":"+Json(TrayIconName)+",\"trayMenuItemName\":"+Json(TrayMenuItemName)+",\"retryCount\":"+RetryCount+",\"retryDelayMilliseconds\":"+RetryDelayMilliseconds+"}"); return 0;
        }
        IntPtr window = FindWindow();
        if (window!=IntPtr.Zero) return Activate(window) ? 0 : 3;
        bool hasTrayIcon = false;
        try { hasTrayIcon = FindTrayIcon()!=null; } catch (ElementNotAvailableException) { } catch (InvalidOperationException) { }
        string action = DetermineAction(false, hasTrayIcon);
        if (action=="open-tray") return OpenFromTray() ? 0 : 4;
        if (!File.Exists(expandedTarget)) { MessageBox.Show("Executable not found:\r\n"+expandedTarget,"Tray App Launcher",MessageBoxButtons.OK,MessageBoxIcon.Error); return 2; }
        try { Process.Start(new ProcessStartInfo { FileName=expandedTarget, Arguments=FixedArguments, WorkingDirectory=Path.GetDirectoryName(expandedTarget), UseShellExecute=false }); return 0; }
        catch(Exception exception) { MessageBox.Show("Failed to launch application:\r\n"+exception.Message,"Tray App Launcher",MessageBoxButtons.OK,MessageBoxIcon.Error); return 1; }
    }
}
