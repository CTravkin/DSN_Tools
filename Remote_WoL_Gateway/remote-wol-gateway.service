[Unit]
Description=Authenticated remote Wake-on-LAN gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remote-wol-gateway
Group=remote-wol-gateway
EnvironmentFile=/etc/remote-wol-gateway/remote-wol-gateway.env
ExecStart=/usr/bin/python3 -u /usr/local/sbin/remote-wol-gateway
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
