WOL_TOKEN=replace-with-a-long-random-token
WOL_TARGET_NAME=workstation
WOL_TARGET_IP=192.0.2.10
WOL_TARGET_MAC=02:00:00:00:00:01
WOL_BIND=127.0.0.1
WOL_PORT=18080
WOL_WAIT_SECONDS=60
WOL_PROBE_INTERVAL_SECONDS=2
WOL_CHECK_PING=true
WOL_CHECK_PORTS=22,3389
WOL_SEND_MODE=local
WOL_BROADCAST_IP=255.255.255.255
WOL_BROADCAST_PORT=9

# SSH-hop mode only:
# WOL_SEND_MODE=ssh
# WOL_SSH_HOST=router.example
# WOL_SSH_USER=wake
# WOL_SSH_KEY=/etc/remote-wol-gateway/wake_ed25519
# WOL_SSH_KNOWN_HOSTS=/etc/remote-wol-gateway/known_hosts
# WOL_SSH_INTERFACE=br-lan
# WOL_SSH_EXECUTABLE=/usr/local/sbin/remote-wol-sender
